## .gitignore
# build output
dist/
# generated types
.astro/
# wrangler local state
.wrangler/
# fonts for the share images, downloaded by src/pages/og/[id].webp.ts
/og/fonts/

# dependencies
node_modules/
.vscode/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# environment variables
.env
.env.production
mise.local.toml

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/