---
// src/layouts/Layout.astro
import '../styles/global.css'
import { Font } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import CopyButton from '../components/CopyButton.svelte'
import QRCardDialog from '../components/QRCardDialog.astro'

const siteConfig = {
  siteName: 'orbit.supply',
  siteDescription: 'Tech blog about web development and programming',
} as const

interface Props {
  pageTitle?: string
  pageDescription?: string
  pagePublished?: Date
  pageEdited?: Date
  pageTags?: string[]
}

const { pageTitle, pageDescription, pagePublished, pageEdited, pageTags } =
  Astro.props

const title = pageTitle
  ? `${pageTitle} | ${siteConfig.siteName}`
  : siteConfig.siteName

const description = pageDescription ?? siteConfig.siteDescription

// build.format が 'file' なので Astro.url は .html で終わる。Workers は .html を外した URL で配信する（/index.html は /）
const pageUrl = new URL(
  Astro.url.pathname.replace(/(index)?\.html$/, ''),
  Astro.site,
).toString()
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Google Tag Manager -->
    <!-- biome-ignore format: Google Tag Manager の公式スニペットをそのまま貼る -->
    <script is:inline>/* biome-ignore-all lint: Google Tag Manager の公式スニペットをそのまま貼る */
/* biome-ignore format: Google Tag Manager の公式スニペットをそのまま貼る */
(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-KTN3TQZ9');</script>
    <!-- End Google Tag Manager -->

    <Font
      cssVariable="--font-lato"
      preload={[{ weight: 400, style: 'normal' }]}
    />
    <Font cssVariable="--font-raleway" preload />

    <title>{title}</title>
    <meta name="description" content={description}>
    <meta property="og:site_name" content={siteConfig.siteName}>
    <meta property="og:image" content="/ogimage.avif">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    >
    <link
      rel="icon"
      href="/favicon-dark.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    >
    <link rel="apple-touch-icon" href="/touch-icon.png">

    <meta name="generator" content={Astro.generator}>
  </head>

  <body class="min-h-screen flex flex-col bg-gray-2 text-slate-12">
    <!-- Google Tag Manager (noscript) -->
    <!-- biome-ignore format: Google Tag Manager の公式スニペットをそのまま貼る -->
    <!-- biome-ignore lint/a11y/useIframeTitle: Google Tag Manager の公式スニペットをそのまま貼る -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KTN3TQZ9"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- 22.5+142+640+23+22.5 -->
    <header class="w-full flex h-14 items-center px-6">
      {/* 左側エリア - 大画面で右寄せ、小画面で左寄せ */}
      <div class="flex-1 flex justify-start min-[858px]:justify-end">
        <a href="/" class="flex items-center gap-2 group hover:no-underline">
          <Icon name="lucide:orbit" class="w-6 h-6 text-lime-11 icons" />
          <span
            class="text-xl font-bold font-display text-slate-11 hover:text-slate-12 "
            >{siteConfig.siteName}</span
          >
        </a>
      </div>

      {/* スペーサー - 大画面でのみ表示 */}
      <div class="w-[640px] shrink-0 hidden min-[858px]:block" />

      {/* 右側エリア - 大画面で左寄せ、小画面で右寄せ */}
      <div class="flex-1 flex justify-end min-[858px]:justify-start">
        <button
          type="button"
          command="show-modal"
          commandfor="qr-card"
          aria-haspopup="dialog"
          aria-label="Save page card"
          class="group py-2 pl-2"
        >
          <Icon
            name="lucide:qr-code"
            class="w-6 h-6 text-slate-11 group-hover:text-slate-12"
          />
        </button>
      </div>
    </header>

    <main class="content-wrapper mt-7">
      <slot />
    </main>

    <footer
      class="mt-auto py-8 content-wrapper flex flex-col items-center gap-4"
    >
      <div class="flex items-center gap-4">
        <a
          href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(pageTitle ? `${pageTitle} | ${siteConfig.siteName}` : siteConfig.siteName)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 group"
          aria-label="Tweet"
        >
          <Icon
            name="lucide:twitter"
            class="w-6 h-6 text-slate-11 group-hover:text-slate-12"
          />
        </a>
        <CopyButton client:idle class="p-2 group relative">
          <Icon
            name="lucide:link-2"
            class="w-6 h-6 text-slate-11 group-hover:text-slate-12"
          />
          <Icon
            name="lucide:circle-check"
            class="w-4 h-4 text-lime-8"
            slot="feedback-icon"
          />
        </CopyButton>
        <button
          type="button"
          command="show-modal"
          commandfor="qr-card"
          aria-haspopup="dialog"
          aria-label="Save page card"
          class="p-2 group"
        >
          <Icon
            name="lucide:qr-code"
            class="w-6 h-6 text-slate-11 group-hover:text-slate-12"
          />
        </button>
      </div>
      <div class="text-sm text-slate-11 font-display">
        <a
          href="/"
          class="text-slate-11 hover:text-slate-12 hover:no-underline"
        >
          © {new Date().getFullYear()} {siteConfig.siteName}
        </a>
      </div>
    </footer>

    <QRCardDialog
      pageUrl={pageUrl}
      pageTitle={pageTitle}
      pagePublished={pagePublished}
      pageEdited={pageEdited}
      pageTags={pageTags}
      siteName={siteConfig.siteName}
    />
  </body>
</html>

<style>
/** Header **/
.group:hover .icons {
  transform: rotate(-180deg);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.group:not(:hover) .icons {
  transform: rotate(0deg);
  animation: rotateBack 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes rotateBack {
  from {
    transform: rotate(-180deg);
  }
  to {
    transform: rotate(-360deg);
  }
}

/* n-px以上でのみスティッキー化, nは中央カラムの幅から手計算で */
@media (min-width: 969px) {
  header {
    position: sticky;
    top: 0;
    z-index: 20;
  }
}
</style>
