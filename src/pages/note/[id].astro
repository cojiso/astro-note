---
// src/pages/note/[id].astro
// import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content'
import Toc from '../../components/Toc.astro'
import Layout from '../../layouts/Layout.astro'
import { formatDate, formatDateAttr, generateTagPath } from '../../lib/note'

export async function getStaticPaths() {
  const notes = await getCollection('note', ({ data }) => {
    return import.meta.env.DEV || data.public === true
  })

  return notes.map((note) => ({
    params: { id: note.data.id },
    props: { note },
  }))
}

const { note } = Astro.props
const { Content, headings } = await render(note)
---

<Layout
  pageTitle={note.data.title}
  pageDescription={note.data.description ?? undefined}
  pagePublished={note.data.publishedAt}
  pageEdited={note.data.editedAt ?? undefined}
  pageTags={note.data.tags ?? undefined}
  pageImage={`/og/${note.data.id}.webp`}
>
  <Toc slot="header-actions" headings={headings} />
  <article>
    <!-- 記事の導入。本文用の prose の外に置き、題名・日付・タグは自前のクラスで組む -->
    <header class="mb-20">
      <h1 class="text-xl font-bold md:text-2xl text-center mb-3">
        {note.data.title}
      </h1>
      <div class="flex flex-col text-slate-11 font-mono md:justify-center">
        <div
          class="flex justify-center items-center gap-3 font-display text-sm"
        >
          {note.data.editedAt &&
          note.data.editedAt.getTime() !== note.data.publishedAt.getTime() ? (
              <time
                datetime={formatDateAttr(note.data.publishedAt)}
                class="flex-1 text-right"
              >
                {formatDate(note.data.publishedAt)}
              </time>
              <span class="text-slate-9">→</span>
              <time
                datetime={formatDateAttr(note.data.editedAt)}
                class="flex-1"
              >
                {formatDate(note.data.editedAt)}
              </time>
          ) : (
            <time
              datetime={formatDateAttr(note.data.publishedAt)}
              class="flex-1 text-center"
            >
              {formatDate(note.data.publishedAt)}
            </time>
          )}
        </div>
        <div class="flex flex-wrap gap-3 justify-center mt-3">
          {note.data.tags?.map((tag) => (
            <a
              href={generateTagPath(tag)}
              class="pill hover-overlay inner relative"
            >
              {tag}
            </a>
          ))}
        </div>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>
