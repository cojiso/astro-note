---
// src/pages/index.astro

import { Icon } from 'astro-icon/components'
import Layout from '../layouts/Layout.astro'
import { formatDate, generateNotePath, getAllPublicNotes } from '../lib/note'

const notes = await getAllPublicNotes()

const links = [
  {
    name: 'GitHub',
    url: 'https://github.com/cojiso',
    icon: 'lucide:github',
  },
]

const projects = [
  {
    title: 'orbit.supply',
    description: 'Blog, Link in Bio, Portfolio',
    url: 'https://orbit.supply',
    status: 'active', // active, beta, archived
    tech: [
      'Astro',
      'TypeScript',
      'Tailwind',
      'Cloudflare Workers',
      'Lucide Icons',
    ],
    lastUpdated: '2026-11',
    icon: 'lucide:file-text',
  },
  {
    title: 'NDC Scroll',
    description: 'NDC9の表示探索Webツール',
    url: 'https://ndc-scroll.orbit.supply',
    status: 'active',
    tech: ['Svelte', 'TypeScript', 'Cloudflare Pages'],
    lastUpdated: '2024-10',
    icon: 'lucide:library', // サービスのアイコン
  },
  {
    title: 'RDF Map',
    description: 'ジャパンサーチのデータを表示するMapツール',
    url: 'https://rdf-map.orbit.supply/kamakura',
    status: 'archived',
    tech: ['Svelte', 'Leaflet', 'Virtuoso', 'GCE', 'Cloudflare Pages'],
    lastUpdated: '2023-11',
    icon: 'lucide:map-pinned',
  },
  {
    title: '新古書店横断検索',
    description: 'unitrad-uiをフォークし書店検索機能を追加したもの',
    url: 'https://b.orbit.supply',
    status: 'active',
    tech: ['Svelte', 'unitrad-ui', 'GCR'],
    lastUpdated: '2025-09',
    icon: 'lucide:book-alert',
  },
  {
    title: 'cReturn',
    description:
      'どんなサイトでも、Enterで改行、Ctrl+Enterで送信できる、Chrome拡張機能',
    url: 'https://chromewebstore.google.com/detail/creturn/dpfkfjilfchkjcohjfmdnlmecgbpakfd',
    status: 'active',
    tech: ['WXT', 'React', 'Chrome Extensions'],
    lastUpdated: '2025-08',
    icon: 'lucide:chromium',
  },
]
---

<Layout>
  <section class="mb-13">
    <h2 class="text-xl font-bold mb-5 pb-3 border-b border-slate-5">Notes</h2>
    <div>
      {notes.map((note) => (
        <a
          href={generateNotePath(note.data.id)}
          class="hover-overlay [--hover-overlay-y:0] flex justify-between gap-5 items-center py-5"
        >
          <h3 class="text-base font-medium text-slate-12 transition-colors">
            {note.data.title}
          </h3>
          <time class="text-sm text-slate-11 font-display">
            {formatDate(note.data.publishedAt)}
          </time>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-13">
    <h2 class="text-xl font-bold mb-8 pb-3 border-b border-slate-5">
      Projects
    </h2>
    <div class="grid gap-5 md:grid-cols-2">
      {projects.map((project) => (
        <a
          href={project.url}
          class="hover-overlay flex gap-5 p-5 border rounded-lg bg-white group"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="flex items-center justify-center w-13 h-13 rounded-lg bg-slate-3">
            <Icon
              name={project.icon}
              size={20}
              class="text-slate-11 group-hover:text-slate-12"
            />
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-3">
              <h3 class="text-base font-medium text-slate-12">
                {project.title}
              </h3>
              {(project.status === 'beta' || project.status === 'archived') && (
                <span class="pill">
                  {project.status === 'beta' ? 'Beta' : 'Archived'}
                </span>
              )}
              <Icon
                name={
                  project.status === 'archived'
                    ? 'lucide:x'
                    : 'lucide:arrow-up-right'
                }
                size={16}
                class:list={[
                  'ml-auto transition-colors',
                  {
                    'text-lime-8 group-hover:text-lime-11':
                      project.status === 'active',
                    'text-amber-8 group-hover:text-amber-11':
                      project.status === 'beta',
                    'text-red-8 group-hover:text-red-11':
                      project.status === 'archived',
                  },
                ]}
              />
            </div>
            <p class="text-sm text-slate-11">{project.description}</p>
            <div class="mt-3 flex flex-wrap gap-3">
              {project.tech.map((tech) => (
                <span class="pill">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-13">
    <h2 class="text-xl font-bold mb-8 pb-3 border-b border-slate-5">Links</h2>
    <div class="grid gap-5">
      {links.map(({ name, url, icon }) => (
        <a
          href={url}
          class="hover-overlay flex items-center gap-5 p-5 border rounded-lg bg-white group"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="flex items-center justify-center w-13 h-13 rounded-lg bg-slate-3 transition-colors">
            <Icon
              name={icon}
              size={20}
              class="text-slate-11 group-hover:text-slate-12"
            />
          </div>
          <span class="text-base font-medium text-slate-12">{name}</span>
          <Icon
            name="lucide:arrow-up-right"
            size={16}
            class="ml-auto text-slate-9 group-hover:text-slate-11 transition-colors"
          />
        </a>
      ))}
    </div>
  </section>

  <section class="prose">
    <h2 class="text-xl font-bold mb-8 pb-3 border-b border-slate-5">About</h2>
    <p>
      本サイトのコンテンツについて、引用部分や第三者の著作物を除き、別段の記載がない限り、私の文章および図表はCC
      BY 4.0で、ソースコードはMITライセンスで公開します。
    </p>
    <p>
      本サイトはアクセス解析のために<a
        href="https://www.google.com/policies/privacy/partners/"
        >Google Analytics(Cookie等を使用しユーザーから情報を収集する)</a
      >を使用しています。
    </p>
  </section>
</Layout>
