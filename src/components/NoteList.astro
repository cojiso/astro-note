---
// src/components/NoteList.astro
// ノートの一覧。題名と公開日を 1 行ずつ並べる

import type { CollectionEntry } from 'astro:content'
import { formatDate, formatDateAttr, generateNotePath } from '../lib/note'

interface Props {
  notes: CollectionEntry<'note'>[]
}

const { notes } = Astro.props
---

<div>
  {notes.map((note) => (
    <a
      href={generateNotePath(note.data.id)}
      class="hover-overlay [--hover-overlay-y:0] flex justify-between gap-5 items-center py-5"
    >
      <h3 class="text-base font-medium text-slate-12 transition-colors">
        {note.data.title}
      </h3>
      <time
        datetime={formatDateAttr(note.data.publishedAt)}
        class="text-sm text-slate-11 font-display"
      >
        {formatDate(note.data.publishedAt)}
      </time>
    </a>
  ))}
</div>
